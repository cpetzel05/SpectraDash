[Unit]
Description=SpectraDash weather dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spectradash
Group=spectradash
WorkingDirectory=/opt/spectradash
Environment=SPECTRADASH_CONFIG=/etc/spectradash/config.json
ExecStart=/opt/spectradash/venv/bin/spectradash
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/spectradash /var/lib/spectradash

[Install]
WantedBy=multi-user.target
