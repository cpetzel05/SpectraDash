[Unit]
Description=SpectraDash display refresh worker
After=network-online.target spectradash.service
Wants=network-online.target

[Service]
Type=simple
User=spectradash
Group=spectradash
WorkingDirectory=/opt/spectradash
Environment=SPECTRADASH_CONFIG=/etc/spectradash/config.json
ExecStart=/opt/spectradash/venv/bin/spectradash-worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/spectradash /var/lib/spectradash
SupplementaryGroups=gpio spi

[Install]
WantedBy=multi-user.target
